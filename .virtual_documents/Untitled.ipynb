def describe(n):
    """
    zwraca opis

    Args:
        n: liczba calkowita do opisania

    Returns:
        String opisujacy liczbe
    """

    if n == 0:
        return "zero"
    
    sign = "positive" if n > 0 else "negtive"
    parity = "even" if n % 2 == 0 else "odd"

    
    
    
    return f"{sign} {parity}"


print(describe(1))


